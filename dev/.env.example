POSTGRES_DB=fiapx
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=fiapx

RABBITMQ_USER=fiapx
RABBITMQ_PASSWORD=fiapx

# O S3Mock aceita qualquer credencial; "test" é a convenção.
# Na AWS estes três viram credencial real e a região do bucket.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Endpoint que os SERVIÇOS usam. No compose, de dentro da rede: http://s3:9090
# ⚠️ O endpoint do PRESIGNER é outro e tem de ser alcançável pelo NAVEGADOR — ver o README.
S3_ENDPOINT=http://localhost:9090
S3_BUCKET_VIDEOS=fiapx-videos
S3_BUCKET_ZIPS=fiapx-zips

CORS_ALLOW_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:8090
